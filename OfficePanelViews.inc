void Panel::arrangeDashboard() {
    if(!dashboardGrid || dashboardGrid->count())return;
    dashboardStatus->setMinimumWidth(155);dashboardStatus->setMaximumWidth(240);
    dashboardGrid->addWidget(dashboardStatus,0,0,2,1);
    auto top=new QWidget;auto topRow=new QHBoxLayout(top);topRow->setContentsMargins(0,0,0,0);topRow->setSpacing(10);
    auto bottom=new QWidget;auto bottomRow=new QHBoxLayout(bottom);bottomRow->setContentsMargins(0,0,0,0);bottomRow->setSpacing(10);
    for(int i=0;i<3;++i)topRow->addWidget(dashboardCards[i],1);
    for(int i=3;i<7;++i)bottomRow->addWidget(dashboardCards[i],1);
    dashboardGrid->addWidget(top,0,1);dashboardGrid->addWidget(bottom,1,1);dashboardGrid->setColumnStretch(0,8);dashboardGrid->setColumnStretch(1,36);
}

